<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BiomePampa.ViewModels"
             x:Class="BiomePampa.Views.BatchDetailPage"
             x:DataType="vm:BatchDetailViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Batch Number -->
            <Label Text="Número do Lote *" FontAttributes="Bold" />
            <Entry Text="{Binding BatchNumber}" Placeholder="Número do lote" />

            <!-- Product (placeholder - ideally would be a picker with products) -->
            <Label Text="Produto *" FontAttributes="Bold" />
            <Entry Text="{Binding ProductId}" 
                   Placeholder="ID do Produto (usar Picker em produção)" 
                   IsReadOnly="True" />

            <!-- Production Date -->
            <Label Text="Data de Produção *" FontAttributes="Bold" />
            <DatePicker Date="{Binding ProductionDate}" />

            <!-- Expiration Date -->
            <Label Text="Data de Validade *" FontAttributes="Bold" />
            <DatePicker Date="{Binding ExpirationDate}" />

            <!-- Quantities Section -->
            <Label Text="Quantidades" 
                   FontSize="20" 
                   FontAttributes="Bold" 
                   Margin="0,20,0,10" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <!-- Initial Quantity -->
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="Quantidade Inicial *" FontAttributes="Bold" />
                    <Entry Text="{Binding InitialQuantity}" 
                           Placeholder="0,00"
                           Keyboard="Numeric" />
                </VerticalStackLayout>

                <!-- Current Quantity -->
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="Quantidade Atual *" FontAttributes="Bold" />
                    <Entry Text="{Binding CurrentQuantity}" 
                           Placeholder="0,00"
                           Keyboard="Numeric" />
                </VerticalStackLayout>
            </Grid>

            <!-- Supplier (placeholder) -->
            <Label Text="Fornecedor" FontAttributes="Bold" />
            <Entry Text="{Binding SupplierId}" 
                   Placeholder="ID do Fornecedor (opcional)" />

            <!-- Notes -->
            <Label Text="Observações" FontAttributes="Bold" />
            <Editor Text="{Binding Notes}" 
                    Placeholder="Observações sobre o lote"
                    HeightRequest="100" />

            <!-- Buttons -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,20,0,0">
                <Button Grid.Column="0"
                        Text="Cancelar"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="Gray" />
                
                <Button Grid.Column="1"
                        Text="Salvar"
                        Command="{Binding SaveCommand}"
                        BackgroundColor="#512BD4" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
