<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BiomePampa.ViewModels"
             x:Class="BiomePampa.Views.BatchListPage"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,*" Padding="10">
        
        <!-- Header with Add Button -->
        <Button Grid.Row="0"
                Text="Adicionar Lote"
                Command="{Binding AddBatchCommand}"
                HorizontalOptions="End"
                Margin="0,0,0,10" />

        <!-- Batches List -->
        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding RefreshCommand}">
            
            <CollectionView ItemsSource="{Binding Batches}"
                            SelectionMode="None">
                
                <CollectionView.EmptyView>
                    <StackLayout Padding="20" VerticalOptions="Center">
                        <Label Text="Nenhum lote cadastrado"
                               HorizontalOptions="Center"
                               FontSize="16"
                               TextColor="Gray" />
                        <Label Text="Toque em 'Adicionar Lote' para começar"
                               HorizontalOptions="Center"
                               FontSize="14"
                               TextColor="Gray"
                               Margin="0,10,0,0" />
                    </StackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <SwipeView>
                            <!-- Swipe Actions -->
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Excluir"
                                               BackgroundColor="Red"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BatchListViewModel}}, Path=DeleteBatchCommand}"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <!-- Batch Item -->
                            <Frame Padding="10" Margin="5" HasShadow="True">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BatchListViewModel}}, Path=EditBatchCommand}"
                                        CommandParameter="{Binding .}" />
                                </Frame.GestureRecognizers>

                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                                    <!-- Batch Number -->
                                    <Label Grid.Row="0" Grid.Column="0"
                                           Text="{Binding BatchNumber}"
                                           FontSize="18"
                                           FontAttributes="Bold" />

                                    <!-- Status Badge -->
                                    <Label Grid.Row="0" Grid.Column="1"
                                           Text="{Binding IsActive, Converter={StaticResource BoolToStatusConverter}}"
                                           BackgroundColor="{Binding IsActive, Converter={StaticResource BoolToColorConverter}}"
                                           TextColor="White"
                                           Padding="8,4"
                                           FontSize="12"
                                           VerticalOptions="Center" />

                                    <!-- Product Name -->
                                    <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{Binding ProductName, StringFormat='Produto: {0}'}"
                                           FontSize="14"
                                           TextColor="Gray"
                                           Margin="0,5,0,0" />

                                    <!-- Dates -->
                                    <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{Binding ProductionDate, StringFormat='Produção: {0:dd/MM/yyyy}'}"
                                           FontSize="14"
                                           Margin="0,2,0,0" />

                                    <Label Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{Binding ExpirationDate, StringFormat='Validade: {0:dd/MM/yyyy}'}"
                                           FontSize="14"
                                           Margin="0,2,0,0" />

                                    <!-- Quantity -->
                                    <Label Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{Binding CurrentQuantity, StringFormat='Quantidade: {0:N2}'}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="Green"
                                           Margin="0,5,0,0" />
                                </Grid>
                            </Frame>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                
            </CollectionView>
        </RefreshView>

        <!-- Loading Indicator -->
        <ActivityIndicator Grid.Row="1"
                          IsRunning="{Binding IsBusy}"
                          IsVisible="{Binding IsBusy}"
                          HorizontalOptions="Center"
                          VerticalOptions="Center" />
    </Grid>
    
</ContentPage>
