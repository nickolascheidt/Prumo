<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BiomePampa.ViewModels"
             x:Class="BiomePampa.Views.CustomerDetailPage"
             x:DataType="vm:CustomerDetailViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Personal Information Section -->
            <Label Text="Informações Pessoais" 
                   FontSize="20" 
                   FontAttributes="Bold" />

            <!-- Name -->
            <Label Text="Nome *" FontAttributes="Bold" />
            <Entry Text="{Binding CustomerName}" Placeholder="Nome completo" />

            <!-- Company Name -->
            <Label Text="Nome da Empresa" FontAttributes="Bold" />
            <Entry Text="{Binding CustomerCompanyName}" Placeholder="Nome da empresa (opcional)" />

            <!-- Tax ID -->
            <Label Text="CPF/CNPJ *" FontAttributes="Bold" />
            <Entry Text="{Binding CustomerTaxId}" 
                   Placeholder="CPF ou CNPJ"
                   Keyboard="Numeric" />

            <!-- Contact Section -->
            <Label Text="Contato" 
                   FontSize="20" 
                   FontAttributes="Bold" 
                   Margin="0,20,0,10" />

            <!-- Phone -->
            <Label Text="Telefone" FontAttributes="Bold" />
            <Entry Text="{Binding CustomerPhone}" 
                   Placeholder="(00) 00000-0000"
                   Keyboard="Telephone" />

            <!-- Email -->
            <Label Text="E-mail" FontAttributes="Bold" />
            <Entry Text="{Binding CustomerEmail}" 
                   Placeholder="email@exemplo.com"
                   Keyboard="Email" />

            <!-- Address Section -->
            <Label Text="Endereço" 
                   FontSize="20" 
                   FontAttributes="Bold" 
                   Margin="0,20,0,10" />

            <!-- Address -->
            <Label Text="Logradouro" FontAttributes="Bold" />
            <Entry Text="{Binding CustomerAddress}" Placeholder="Rua, número, complemento" />

            <!-- City and State -->
            <Grid ColumnDefinitions="2*,*" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="Cidade" FontAttributes="Bold" />
                    <Entry Text="{Binding CustomerCity}" Placeholder="Cidade" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1">
                    <Label Text="UF" FontAttributes="Bold" />
                    <Entry Text="{Binding CustomerState}" 
                           Placeholder="UF"
                           MaxLength="2" />
                </VerticalStackLayout>
            </Grid>

            <!-- Zip Code -->
            <Label Text="CEP" FontAttributes="Bold" />
            <Entry Text="{Binding CustomerZipCode}" 
                   Placeholder="00000-000"
                   Keyboard="Numeric" />

            <!-- Notes -->
            <Label Text="Observações" 
                   FontAttributes="Bold"
                   Margin="0,20,0,0" />
            <Editor Text="{Binding CustomerNotes}" 
                    Placeholder="Observações sobre o cliente"
                    HeightRequest="100" />

            <!-- Buttons -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,20,0,0">
                <Button Grid.Column="0"
                        Text="Cancelar"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="Gray" />
                
                <Button Grid.Column="1"
                        Text="Salvar"
                        Command="{Binding SaveCommand}"
                        BackgroundColor="#512BD4" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
