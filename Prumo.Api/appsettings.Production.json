{
  "ConnectionStrings": {
    "DefaultConnection": "CONFIGURE_VIA_ENVIRONMENT"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Jwt": {
    "Issuer": "PrumoApi",
    "Audience": "PrumoClient"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "PermitLimit": 60,
    "Window": 60,
    "QueueLimit": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Error"
    }
  },
  "AllowedHosts": ""
}
