{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=SaaSBasePlatformDb;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "Redis": {
    "InstanceName": "saasbase-redis"
  },
  "Jwt": {
    "Issuer": "PrumoApi",
    "Audience": "PrumoClient",
    "TokenExpirationHours": 8
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://localhost:3000",
      "http://localhost:5173",
      "https://localhost:5173",
      "http://localhost:4200",
      "https://localhost:4200"
    ]
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "Window": 60,
    "QueueLimit": 10
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
        "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [ "FromLogContext", "WithThreadId" ]
  },
  "AllowedHosts": "*"
}
