<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-Prumo.Notifications-a2087afc-17b3-47be-91d8-b12f746cb4f8</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.SimpleEmailV2" Version="4.0.104" />
    <PackageReference Include="AWSSDK.SQS" Version="4.0.100.11" />
    <PackageReference Include="Azure.Communication.Email" Version="1.1.0" />
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.20.2" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- Os templates viajam dentro do assembly: o container não deve depender de arquivo
         solto ao lado do binário. Ver NotificationRenderer.LoadTemplate. -->
    <EmbeddedResource Include="Templates\*.html" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Prumo.Notifications.Contracts\Prumo.Notifications.Contracts.csproj" />
  </ItemGroup>
</Project>
